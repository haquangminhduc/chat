# Comma-separated Gemini keys for local development.
# Never commit real API keys to this file.
VITE_GEMINI_API_KEYS=AIzaSyExampleKey1,AIzaSyExampleKey2
VITE_GEMINI_DEFAULT_MODEL=gemini-3.6-flash
VITE_GEMINI_TEMPERATURE=0.7
# Khi deploy Vercel, đặt URL function, ví dụ: /api/chat
VITE_GEMINI_PROXY_URL=
# Chỉ dùng ở serverless environment, không thêm vào VITE_*.
GEMINI_API_KEYS=server_key_1,server_key_2
